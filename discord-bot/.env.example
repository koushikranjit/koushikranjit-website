# Discord Developer Portal → your application
DISCORD_TOKEN=
CLIENT_ID=
# Optional while testing: registers commands instantly to one server instead of globally (~1hr propagation)
GUILD_ID=

# Branding (used in embed titles/footers to match your server's look)
BRAND_NAME=
CURRENCY_LABEL=USDT
CURRENCY_SYMBOL=₹

# Channels (right-click a channel → Copy Channel ID, Developer Mode must be on)
PRICE_CHANNEL_ID=
DEAL_LOG_CHANNEL_ID=
WELCOME_CHANNEL_ID=

# Roles (right-click a role → Copy Role ID)
SUPPORT_ROLE_ID=
AUTO_ROLE_ID=

# Category new ticket/deal channels get created under (right-click category → Copy Channel ID)
TICKET_CATEGORY_ID=

# Daily price post schedule
DAILY_PRICE_HOUR=9
DAILY_PRICE_TIMEZONE=Asia/Kolkata
PING_EVERYONE_ON_PRICE_UPDATE=false
